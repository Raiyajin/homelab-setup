{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a '# renovate:' comment (e.g. app-of-apps targetRevision)",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\S+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "{{manager}} non-major"
    },
    {
      "description": "Longhorn only supports upgrading one minor version at a time: one PR per minor, never grouped",
      "matchPackageNames": [
        "longhorn"
      ],
      "separateMultipleMinor": true,
      "groupName": null
    }
  ]
}
